{
  "name": "csddr",
  "version": "2.1.0",
  "private": true,
  "description": "Consumer DDR Song List",
  "scripts": {
    "prepare": "nuxi prepare",
    "dev": "nuxi dev",
    "build": "nuxi build",
    "preview": "nuxi preview",
    "fix": "pnpm run \"/^fix:.+/\"",
    "fix:eslint": "eslint . --fix",
    "fix:oxfmt": "oxfmt",
    "fix:oxlint": "oxlint --type-aware . --fix --fix-suggestions",
    "lint": "pnpm run \"/^lint:.+/\"",
    "lint:eslint": "eslint .",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint --type-aware .",
    "lint:tsc": "nuxi typecheck"
  },
  "dependencies": {
    "@iconify-json/flag": "^1.2.13",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/mdc": "^0.23.2",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "24.x",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.89.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.28.8"
}
