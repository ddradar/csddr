{
  "name": "csddr",
  "version": "2.1.0",
  "private": true,
  "description": "Consumer DDR Song List",
  "scripts": {
    "prepare": "nuxi prepare",
    "dev": "nuxi dev",
    "build": "nuxi build",
    "preview": "nuxi preview",
    "fix": "pnpm run \"/^fix:.+/\"",
    "fix:eslint": "eslint . --fix",
    "fix:oxfmt": "oxfmt",
    "fix:oxlint": "oxlint --type-aware . --fix --fix-suggestions",
    "lint": "pnpm run \"/^lint:.+/\"",
    "lint:eslint": "eslint .",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint --type-aware .",
    "lint:tsc": "nuxi typecheck"
  },
  "dependencies": {
    "@iconify-json/flag": "^1.2.13",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/mdc": "^0.23.2",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "24.x",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.88.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.28.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "vue-demi"
    ]
  }
}
